	(text "V_{S}电平即为VCC电平\n所以替代二极管的NMOS如果需要导通的话\n需要V_{G}的电平大于VCC\n正常情况下不容易得到，\n需要用能够抬升电压的电路进行驱动\n\n在LM5122中，使用了电荷泵抬高电压\n在TPS43060中使用了某种偏置方法太高电压\n使得V_{G}=VCC+7.5V，NMOS能够导通"
		(exclude_from_sim no)
		(at 169.164 46.99 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3f9055b5-2007-41a6-926b-9c823bc11c3d")
	)
	(text "EN浮空使能IC\n0.4-1.2V进入低电流备用模式\n低于0.4V进入关断模式"
		(exclude_from_sim no)
		(at 94.742 101.854 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5d82510b-80f8-4191-bb82-ae9ee1bbdfa4")
	)
	(text "V_{FB}=1.22"
		(exclude_from_sim no)
		(at 143.764 116.078 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "68c0bbf4-199b-4a73-8c18-532b3e9f0a41")
	)
	(text "V_{OUT} =1.22*(200/10.7+1)\n	=1.22*19.69\n	=24.02V"
		(exclude_from_sim no)
		(at 169.418 121.412 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "843dfd32-fd59-4ca1-ac1e-8164763afd79")
	)
